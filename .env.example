# Server Configuration
PORT=3000
NODE_ENV=production

# RapidAPI Security (Optional in local development; when set, requests require matching X-RapidAPI-Proxy-Secret)
# RAPIDAPI_PROXY_SECRET=your_rapidapi_proxy_secret_key_here

# Rate Limiting & Safety (requests per minute per IP for local protection)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
